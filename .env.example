# Development paper account
APP_RUNTIME_CONFIG_REQUIRED=true
APP_ACCOUNT_ROLE=DEVELOPMENT
APP_AUTONOMOUS_ENABLED=false

# Reviewed policy binding.
APP_POLICY_HASH=replace_with_lowercase_sha256_policy_hash
APP_CALIBRATION_HASH=replace_with_lowercase_sha256_calibration_hash

# Frozen calibration times.
APP_CALIBRATION_DECISION_BOUNDARY=replace_with_utc_decision_boundary
APP_CALIBRATION_SEALED_AT=replace_with_utc_seal_time
APP_ENTRY_EQUITY_FLOOR=replace_with_private_entry_equity_floor
APP_MAXIMUM_LIFETIME_ENTRIES=replace_with_private_lifetime_entry_limit
APP_MAXIMUM_LIFETIME_RISK=replace_with_private_lifetime_risk_limit
APP_MAXIMUM_POSITION_LOSS=replace_with_private_position_loss_limit
APP_MAXIMUM_ENTRY_QUANTITY=replace_with_private_entry_quantity_limit
# Development entry collection requires all three exact authorities. Leave them unset for
# the submission role or while no reviewed opportunity plan is active.
# APP_OPPORTUNITY_KEY=replace_with_exact_development_opportunity_key
# APP_OPPORTUNITY_PLAN_VERSION=replace_with_exact_positive_plan_version
# APP_HALT_MAXIMUM_TRADE_AGE_SECONDS=replace_with_bounded_trade_age_seconds
ALPACA_API_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_API_KEY=replace_with_development_paper_key
ALPACA_SECRET_KEY=replace_with_development_paper_secret
ALPACA_PAPER_TRADE=true
DATABASE_URL=postgresql://alphadecay:replace_with_database_password@localhost/alphadecay
APP_OWNER_ACCESS_CODE=replace_with_owner_access_code
APP_SESSION_SECRET=replace_with_random_session_secret
APP_PROVIDER_SETTINGS_SECRET=replace_with_separate_random_provider_settings_secret
APP_OPENAI_COMPATIBLE_ORIGINS=
APP_ALLOWED_ORIGIN=https://alphadecay.example
SCHEDULER_TOKEN=replace_with_random_scheduler_token

# Optional development-only paper account. Keep its history out of submission proof.
ALPACA_DEV_API_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_DEV_API_KEY=replace_with_development_paper_key
ALPACA_DEV_SECRET_KEY=replace_with_development_paper_secret

# Gemini model provider
GEMINI_API_KEY=replace_with_model_key
